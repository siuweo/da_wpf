<Window x:Class="DUC_GUI.ConsoleLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DUC_GUI"
        mc:Ignorable="d"
        Title="IPC Terminal Status - Hệ Thống Lệnh IPC" 
        Height="400" 
        Width="600"
        Background="#0C0C0C">

    <Grid Margin="10">
        <TextBox x:Name="TxtConsoleLog" 
                 FontFamily="Consolas" 
                 FontSize="12" 
                 Foreground="#00FF00" 
                 Background="#0C0C0C" 
                 BorderThickness="0"
                 TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" 
                 IsReadOnly="True"/>
    </Grid>
</Window>
