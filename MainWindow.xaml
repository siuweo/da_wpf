<Window x:Class="DUC_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DUC_GUI.Models"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        mc:Ignorable="d"
        Title="SCARA Robot Controller"
        WindowState="Maximized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <models:ProgramBlockTemplateSelector x:Key="BlockSelector" />

        <Style x:Key="LabelCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="23"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        <Style x:Key="ValueCell" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Width" Value="85"/>
        </Style>
        <!-- Nút jog bị mờ khi IPC báo đã chạm giới hạn theo hướng đó -->
        <Style x:Key="JogButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mẫu hiển thị từng loại khối lệnh -->
        <DataTemplate x:Key="MoveBlockTemplate">
            <Border Background="#EAF4FB" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="3" Margin="1" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F4CD; MOVE  " FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplaySummary}" VerticalAlignment="Center" Foreground="#333"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DelayBlockTemplate">
            <Border Background="#FFF8E1" BorderBrush="#FFC107" BorderThickness="2" CornerRadius="3" Margin="1" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x23F1; DELAY  " FontWeight="Bold" Foreground="#E65100" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplaySummary}" VerticalAlignment="Center" Foreground="#333"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="GpioBlockTemplate">
            <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="3" Margin="1" Padding="6,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A1; GPIO  " FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplaySummary}" VerticalAlignment="Center" Foreground="#333"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="IfBranchBlockTemplate">
            <Border Background="#FFF3E0" BorderBrush="#FF6F00" BorderThickness="2,2,2,1" CornerRadius="3,3,0,0" Margin="1,1,1,0" Padding="6,4">
                <TextBlock Text="{Binding DisplaySummary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#BF360C"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ElseBranchBlockTemplate">
            <Border Background="#FFF3E0" BorderBrush="#FF6F00" BorderThickness="2,1,2,1" Margin="1,0,1,0" Padding="6,4">
                <TextBlock Text="{Binding DisplaySummary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#BF360C"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="EndIfBlockTemplate">
            <Border Background="#FFF3E0" BorderBrush="#FF6F00" BorderThickness="2,1,2,2" CornerRadius="0,0,3,3" Margin="1,0,1,1" Padding="6,4">
                <TextBlock Text="{Binding DisplaySummary}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#BF360C"/>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ================= THANH MENU ================= -->
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="2">
            <MenuItem Header="File" FontSize="13" FontWeight="SemiBold">
                <MenuItem Header="Import (.txt)" Command="{Binding ImportProgCommand}"/>
                <Separator />
                <MenuItem Header="Save (.txt)" Command="{Binding SaveProgCommand}"/>
            </MenuItem>
            <MenuItem Header="Window" FontSize="13" FontWeight="SemiBold">
                <MenuItem Header="Console" Click="MenuConsole_Click"/>
            </MenuItem>
        </Menu>

        <!-- ================= THANH TRẠNG THÁI ================= -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F5F5F7">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="IPC:" FontWeight="Bold"/>
                    <Run Text="{Binding IpcMode, Mode=OneWay}" FontWeight="Bold" Foreground="#005A9E"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem Content="{Binding StatusText}"/>
            <Separator/>
            <StatusBarItem Content="{Binding DriveStatus}"/>
            <Separator/>
            <StatusBarItem Content="{Binding StepText}"/>
            <StatusBarItem HorizontalAlignment="Right" Content="{Binding CameraStatus}"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>   <!-- Cột 1: bảng điều khiển -->
                <ColumnDefinition Width="2*"/>   <!-- Cột 2: mô phỏng 3D -->
                <ColumnDefinition Width="1*"/>   <!-- Cột 3: chương trình + JSON -->
            </Grid.ColumnDefinitions>

            <!-- =================================================================== -->
            <!-- CỘT 1: CONTROL PANEL                                                  -->
            <!-- =================================================================== -->
            <GroupBox Grid.Column="0" Margin="5">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="CONTROL PANEL" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="5">

                        <!-- Kết nối IPC: luôn hiển thị -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="IPC:" Style="{StaticResource LabelCell}" Margin="0,0,3,0"/>
                            <TextBox Grid.Column="1" Text="{Binding IpcAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"
                                     ToolTip="IP của IPC (127.0.0.1 khi chạy scara_sim trong WSL)"/>
                            <Button Content="Connect" Grid.Column="2" Margin="3" Height="30" Background="MediumSeaGreen" Foreground="White" FontWeight="Bold"
                                    Command="{Binding SendCommandToIpcCommand}" CommandParameter="CON"/>
                            <Button Content="Disconnect" Grid.Column="3" Margin="3" Height="30" Background="IndianRed" Foreground="White" FontWeight="Bold"
                                    Command="{Binding SendCommandToIpcCommand}" CommandParameter="DIS"/>
                        </Grid>

                        <!-- Chỉ hiển thị khi IPC xác nhận CON (EtherCAT sẵn sàng) -->
                        <StackPanel Visibility="{Binding IsConnectionConfirmed, Converter={StaticResource BoolToVisConverter}}">

                            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <UniformGrid Columns="2">
                                    <RadioButton Content="Operating Mode" GroupName="MainModeSelector" FontWeight="Bold" HorizontalAlignment="Center"
                                                 IsChecked="{Binding IsOperatingMode, Mode=TwoWay}"/>
                                    <RadioButton Content="Teaching Mode" GroupName="MainModeSelector" FontWeight="Bold" HorizontalAlignment="Center"
                                                 IsChecked="{Binding IsTeachingMode, Mode=TwoWay}"/>
                                </UniformGrid>
                            </Border>

                            <!-- ======================= OPERATING MODE ======================= -->
                            <StackPanel Visibility="{Binding IsOperatingMode, Converter={StaticResource BoolToVisConverter}}">
                                <GroupBox Header="BUTTON COMMAND" Margin="0,0,0,10">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="Start" Grid.Row="0" Grid.Column="0" Margin="3" Height="30" Background="DodgerBlue" Foreground="White" FontWeight="Bold"
                                                Command="{Binding SendCommandToIpcCommand}" CommandParameter="STA"/>
                                        <Button Content="Stop" Grid.Row="0" Grid.Column="1" Margin="3" Height="30" Background="Crimson" Foreground="White" FontWeight="Bold"
                                                Command="{Binding SendCommandToIpcCommand}" CommandParameter="STO"/>

                                        <!-- Halt / Resume: trạng thái lấy từ phản hồi IPC -->
                                        <Button Grid.Row="1" Grid.Column="0" Margin="3" Height="30" Foreground="White" FontWeight="Bold" Command="{Binding SendCommandToIpcCommand}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="Halt"/>
                                                    <Setter Property="Background" Value="Orange"/>
                                                    <Setter Property="CommandParameter" Value="HAL"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHalted}" Value="True">
                                                            <Setter Property="Content" Value="Resume"/>
                                                            <Setter Property="Background" Value="SteelBlue"/>
                                                            <Setter Property="CommandParameter" Value="RES"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Homing" Grid.Row="1" Grid.Column="1" Margin="3" Height="30" Background="DarkSlateGray" Foreground="White" FontWeight="Bold"
                                                Command="{Binding SendCommandToIpcCommand}" CommandParameter="HOM"/>

                                        <!-- Dyna / Trajectory: để trống, chưa hỗ trợ -->
                                        <RadioButton Content="Kinematic" Grid.Row="2" Grid.Column="0" GroupName="ControlMode" FontWeight="Bold" IsChecked="{Binding IsKineMode}" Margin="25,8,0,3"/>
                                        <RadioButton Content="Dynamics" Grid.Row="2" Grid.Column="1" GroupName="ControlMode" FontWeight="Bold" IsChecked="{Binding IsDynaMode}" Margin="25,8,0,3"
                                                     IsEnabled="False" ToolTip="Chưa hỗ trợ – hiện chỉ điều khiển động học"/>
                                        <RadioButton Content="Point-to-point" Grid.Row="3" Grid.Column="0" GroupName="RobotTask" FontWeight="Bold" IsChecked="{Binding IsP2PTask}" Margin="25,5,0,3"/>
                                        <RadioButton Content="Trajectory" Grid.Row="3" Grid.Column="1" GroupName="RobotTask" FontWeight="Bold" IsChecked="{Binding IsTrajectoryTask}" Margin="25,5,0,3"
                                                     IsEnabled="False" ToolTip="Chưa hỗ trợ – hiện chỉ có Point-to-point"/>
                                        <RadioButton Content="Once" Grid.Row="4" Grid.Column="0" GroupName="ExecutionMode" FontWeight="Bold" IsChecked="{Binding IsOnceMode}" Margin="25,5,0,5"
                                                     ToolTip="Chương trình có IF/ELSE/END (camera) luôn chạy kiểu Once cho mỗi vật"/>
                                        <RadioButton Content="Loop" Grid.Row="4" Grid.Column="1" GroupName="ExecutionMode" FontWeight="Bold" IsChecked="{Binding IsLoopMode}" Margin="25,5,0,5"
                                                     ToolTip="Chỉ áp dụng khi chương trình không có khối IF/ELSE/END"/>
                                    </Grid>
                                </GroupBox>

                                <GroupBox Header="PROGRAM BLOCKS" Margin="0,5,0,0">
                                    <StackPanel Margin="4">
                                        <!-- MOVE -->
                                        <GroupBox Header="Move (Z thực tế)" Margin="0,0,0,5" Padding="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="X (mm)" Style="{StaticResource LabelCell}"/>
                                                <TextBox Grid.Column="1" Text="{Binding InputX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                <TextBlock Grid.Column="2" Text="Y (mm)" Style="{StaticResource LabelCell}" Margin="4,0,0,0"/>
                                                <TextBox Grid.Column="3" Text="{Binding InputY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                <TextBlock Grid.Row="1" Text="Z (mm)" Style="{StaticResource LabelCell}"/>
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InputZ, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Theta (°)" Style="{StaticResource LabelCell}" Margin="4,0,0,0"/>
                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding InputTheta, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                <TextBlock Grid.Row="2" Text="Time (ms)" Style="{StaticResource LabelCell}"/>
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InputTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                <Button Grid.Row="3" Grid.ColumnSpan="4" Content="+ ADD MOVE" Margin="0,4,0,0" Height="26"
                                                        Background="#1565C0" Foreground="White" FontWeight="Bold" Command="{Binding AddMoveBlockCommand}"/>
                                            </Grid>
                                        </GroupBox>

                                        <!-- DELAY -->
                                        <GroupBox Header="Delay" Margin="0,0,0,5" Padding="4">
                                            <DockPanel>
                                                <TextBlock Text="Delay (ms):" Style="{StaticResource LabelCell}"/>
                                                <Button DockPanel.Dock="Right" Content="+ ADD" Height="26" Padding="8,0"
                                                        Background="#E65100" Foreground="White" FontWeight="Bold" Command="{Binding AddDelayBlockCommand}"/>
                                                <TextBox Text="{Binding InputDelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                            </DockPanel>
                                        </GroupBox>

                                        <!-- GPIO -->
                                        <GroupBox Header="GPIO (PLC)" Margin="0,0,0,5" Padding="4">
                                            <DockPanel>
                                                <TextBlock Text="PIN:" Style="{StaticResource LabelCell}"/>
                                                <Button DockPanel.Dock="Right" Content="+ ADD" Height="26" Padding="8,0"
                                                        Background="#1B5E20" Foreground="White" FontWeight="Bold" Command="{Binding AddGpioBlockCommand}"/>
                                                <RadioButton DockPanel.Dock="Right" Content="1" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding IsGpioHigh, Mode=TwoWay}"/>
                                                <RadioButton DockPanel.Dock="Right" Content="0" Margin="4,0" VerticalAlignment="Center" IsChecked="{Binding IsGpioLow, Mode=TwoWay}"/>
                                                <ComboBox ItemsSource="{Binding GpioPinOptions}" SelectedItem="{Binding InputGpioPin, Mode=TwoWay}" Height="23" Margin="2,0"/>
                                            </DockPanel>
                                        </GroupBox>

                                        <!-- CAMERA: IF/ELSE/END + bám & gắp -->
                                        <GroupBox Header="Camera – phân loại &amp; gắp vật" Margin="0,0,0,5" Padding="4">
                                            <StackPanel>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock Text="ID vật:" Style="{StaticResource LabelCell}"/>
                                                    <TextBox Text="{Binding InputIfConditionId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                </DockPanel>
                                                <UniformGrid Columns="3" Rows="1" Margin="0,4,0,2">
                                                    <Button Content="+ IF" Margin="2" Height="25" Background="#FF6F00" Foreground="White" FontWeight="Bold"
                                                            Command="{Binding AddIfBranchCommand}" ToolTip="IF/ELSEIF theo ID camera: gắp vật rồi chạy các khối phía sau"/>
                                                    <Button Content="+ ELSE" Margin="2" Height="25" Background="#EF6C00" Foreground="White" FontWeight="Bold"
                                                            Command="{Binding AddElseBranchCommand}" ToolTip="Nhánh cho ID không khớp"/>
                                                    <Button Content="+ END" Margin="2" Height="25" Background="#4A148C" Foreground="White" FontWeight="Bold"
                                                            Command="{Binding AddEndIfCommand}" ToolTip="Kết thúc khối IF"/>
                                                </UniformGrid>

                                                <Expander Header="Cài đặt bám &amp; gắp (PICK)" Margin="0,4,0,0" IsExpanded="False">
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                            <RowDefinition/>
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="Vx băng tải" Style="{StaticResource LabelCell}" ToolTip="mm/s, hệ toạ độ robot (bị thay bằng vx của camera nếu có)"/>
                                                        <TextBox Grid.Column="1" Text="{Binding ConveyorVx}" Style="{StaticResource InputBox}"/>
                                                        <TextBlock Grid.Column="2" Text="Vy" Style="{StaticResource LabelCell}" Margin="4,0,0,0"/>
                                                        <TextBox Grid.Column="3" Text="{Binding ConveyorVy}" Style="{StaticResource InputBox}"/>
                                                        <TextBlock Grid.Row="1" Text="Cao tiếp cận" Style="{StaticResource LabelCell}" ToolTip="mm phía trên mặt vật"/>
                                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PickApproachDz}" Style="{StaticResource InputBox}"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Hạ (ms)" Style="{StaticResource LabelCell}" Margin="4,0,0,0"/>
                                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PickDownMs}" Style="{StaticResource InputBox}"/>
                                                        <TextBlock Grid.Row="2" Text="Kẹp (ms)" Style="{StaticResource LabelCell}"/>
                                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PickGripMs}" Style="{StaticResource InputBox}"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Nhấc (ms)" Style="{StaticResource LabelCell}" Margin="4,0,0,0"/>
                                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PickUpMs}" Style="{StaticResource InputBox}"/>
                                                        <CheckBox Grid.Row="3" Content="Kẹp: PIN" IsChecked="{Binding PickUseGpio}" VerticalAlignment="Center"/>
                                                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding GpioPinOptions}" SelectedItem="{Binding PickGripPin}" Height="23" Margin="2,1"/>
                                                        <CheckBox Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" Content="Mức kẹp = 1" IsChecked="{Binding PickGripHigh}"
                                                                  VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Expander>

                                                <Separator Margin="0,4" Background="#DDDDDD"/>
                                                <TextBlock Text="JSON thử (giả lập Camera):" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                                                <TextBox Text="{Binding InputCameraJson, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                                <Button Content="Apply Camera JSON (Test)" Height="24" Margin="0,2,0,0" Background="#7B1FA2" Foreground="White" FontSize="11"
                                                        Command="{Binding ApplyCameraJsonCommand}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <!-- ======================= TEACHING MODE ======================= -->
                            <StackPanel Visibility="{Binding IsTeachingMode, Converter={StaticResource BoolToVisConverter}}">
                                <GroupBox Header="TEACHING MODE CHOOSE" Margin="0,0,0,10">
                                    <UniformGrid Columns="2" Margin="5">
                                        <RadioButton Content="Handing Mode" GroupName="TeachingSubMode" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"
                                                     IsChecked="{Binding IsHandingMode, Mode=TwoWay}" ToolTip="Nhả khớp để kéo tay robot, vẫn nhận phản hồi vị trí"/>
                                        <RadioButton Content="Jogging Mode" GroupName="TeachingSubMode" FontWeight="Bold" HorizontalAlignment="Center" Margin="5"
                                                     IsChecked="{Binding IsJoggingMode, Mode=TwoWay}" ToolTip="Robot giữ vị trí, tăng/giảm X, Y, Z, Theta từng bước"/>
                                    </UniformGrid>
                                </GroupBox>

                                <GroupBox Header="TEACHING CONFIG">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Jog: nút tự khoá khi chạm giới hạn khớp / biên vùng làm việc / lồng kính -->
                                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Visibility="{Binding IsJoggingMode, Converter={StaticResource BoolToVisConverter}}">
                                            <DockPanel Margin="0,3">
                                                <TextBlock Text="Bước jog:" Width="85" Style="{StaticResource LabelCell}"/>
                                                <TextBlock DockPanel.Dock="Right" Text="mm / °" Style="{StaticResource LabelCell}" Margin="4,0,0,0"/>
                                                <TextBox Text="{Binding JogStep, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}"/>
                                            </DockPanel>
                                            <Grid Margin="0,3" Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="X Jog:" Style="{StaticResource LabelCell}"/>
                                                <Button Grid.Column="1" Content="−" Margin="0,0,3,0" Background="Orange" Style="{StaticResource JogButton}" Command="{Binding JogXMinusCommand}"/>
                                                <Button Grid.Column="2" Content="+" Margin="3,0,0,0" Background="DodgerBlue" Style="{StaticResource JogButton}" Command="{Binding JogXPlusCommand}"/>
                                            </Grid>
                                            <Grid Margin="0,3" Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Y Jog:" Style="{StaticResource LabelCell}"/>
                                                <Button Grid.Column="1" Content="−" Margin="0,0,3,0" Background="Orange" Style="{StaticResource JogButton}" Command="{Binding JogYMinusCommand}"/>
                                                <Button Grid.Column="2" Content="+" Margin="3,0,0,0" Background="DodgerBlue" Style="{StaticResource JogButton}" Command="{Binding JogYPlusCommand}"/>
                                            </Grid>
                                            <Grid Margin="0,3" Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Z Jog:" Style="{StaticResource LabelCell}"/>
                                                <Button Grid.Column="1" Content="−" Margin="0,0,3,0" Background="Orange" Style="{StaticResource JogButton}" Command="{Binding JogZMinusCommand}"/>
                                                <Button Grid.Column="2" Content="+" Margin="3,0,0,0" Background="DodgerBlue" Style="{StaticResource JogButton}" Command="{Binding JogZPlusCommand}"/>
                                            </Grid>
                                            <Grid Margin="0,3" Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="85"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Theta Jog:" Style="{StaticResource LabelCell}"/>
                                                <Button Grid.Column="1" Content="−" Margin="0,0,3,0" Background="Orange" Style="{StaticResource JogButton}" Command="{Binding JogThetaMinusCommand}"/>
                                                <Button Grid.Column="2" Content="+" Margin="3,0,0,0" Background="DodgerBlue" Style="{StaticResource JogButton}" Command="{Binding JogThetaPlusCommand}"/>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="Time (ms):" Grid.Row="4" Style="{StaticResource LabelCell}" Margin="0,5"/>
                                        <TextBox Text="{Binding InputTime, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Grid.Column="1" Style="{StaticResource InputBox}"/>

                                        <Button Content="ADD TEACH POINT" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,15,0,5" Height="35"
                                                Background="SteelBlue" Foreground="White" FontWeight="Bold" FontSize="13"
                                                Command="{Binding AddTeachPointCommand}" ToolTip="Tạo khối MOVE tại toạ độ điểm công tác hiện tại"/>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- =================================================================== -->
            <!-- CỘT 2: TOẠ ĐỘ + MÔ PHỎNG 3D (vị trí các khâu tính theo bảng DH)      -->
            <!-- =================================================================== -->
            <Grid Grid.Column="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F5F5F7" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,5">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Joint:" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" Width="110"/>
                            <TextBlock Text="J1 =" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding J1, StringFormat={}{0:F2} °}" FontWeight="SemiBold" TextAlignment="Right"/></Border>
                            <TextBlock Text="J2 =" VerticalAlignment="Center" Margin="15,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding J2, StringFormat={}{0:F2} °}" FontWeight="SemiBold" TextAlignment="Right"/></Border>
                            <TextBlock Text="J3 =" VerticalAlignment="Center" Margin="15,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding J3, StringFormat={}{0:F2} mm}" FontWeight="SemiBold" TextAlignment="Right"/></Border>
                            <TextBlock Text="J4 =" VerticalAlignment="Center" Margin="15,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding J4, StringFormat={}{0:F2} °}" FontWeight="SemiBold" TextAlignment="Right"/></Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="End-Effector:" FontWeight="Bold" Foreground="#005A9E" VerticalAlignment="Center" Width="110"/>
                            <TextBlock Text="X =" VerticalAlignment="Center" Margin="5,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding RobotX, StringFormat={}{0:F2} mm}" FontWeight="SemiBold" Foreground="#005A9E" TextAlignment="Right"/></Border>
                            <TextBlock Text="Y =" VerticalAlignment="Center" Margin="15,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding RobotY, StringFormat={}{0:F2} mm}" FontWeight="SemiBold" Foreground="#005A9E" TextAlignment="Right"/></Border>
                            <TextBlock Text="Z =" VerticalAlignment="Center" Margin="15,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding RobotZ, StringFormat={}{0:F2} mm}" FontWeight="SemiBold" Foreground="#005A9E" TextAlignment="Right"/></Border>
                            <TextBlock Text="Theta =" VerticalAlignment="Center" Margin="15,0,2,0"/>
                            <Border Style="{StaticResource ValueCell}"><TextBlock Text="{Binding RobotTheta, StringFormat={}{0:F2} °}" FontWeight="SemiBold" Foreground="#005A9E" TextAlignment="Right"/></Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <GroupBox Grid.Row="1" Header="ROBOT 3D SIMULATION">
                    <Grid>
                        <hx:Viewport3DX x:Name="RobotViewport"
                                        EffectsManager="{Binding EffectsManager}"
                                        Camera="{Binding Camera}"
                                        MSAA="Four"
                                        Background="#E9EDF1"
                                        CoordinateSystemLabelForeground="Black"
                                        ShowCoordinateSystem="True">
                            <hx:AmbientLight3D Color="#606060"/>
                            <hx:DirectionalLight3D Color="#FFFFFF" Direction="-0.5,-1,-0.5"/>
                            <hx:DirectionalLight3D Color="#A0A0A0" Direction="0.5,1,0.5"/>

                            <hx:LineGeometryModel3D Geometry="{Binding GridGeometry}" Color="#9AA3AD" Thickness="0.8"/>

                            <!-- Mỗi khâu đặt theo hệ toạ độ DH của nó (xem RobotParameters.DhTable / Links) -->
                            <hx:MeshGeometryModel3D Geometry="{Binding Link0Geometry}" Material="{Binding Link0Material}" Transform="{Binding Link0Transform}"/>
                            <hx:MeshGeometryModel3D Geometry="{Binding Link1Geometry}" Material="{Binding Link1Material}" Transform="{Binding Link1Transform}"/>
                            <hx:MeshGeometryModel3D Geometry="{Binding Link2Geometry}" Material="{Binding Link2Material}" Transform="{Binding Link2Transform}"/>
                            <hx:MeshGeometryModel3D Geometry="{Binding Link3Geometry}" Material="{Binding Link3Material}" Transform="{Binding Link3Transform}"/>
                            <hx:MeshGeometryModel3D Geometry="{Binding Link4Geometry}" Material="{Binding Link4Material}" Transform="{Binding Link4Transform}"/>
                        </hx:Viewport3DX>
                        <TextBlock Text="{Binding LinkColorLegend}" VerticalAlignment="Bottom" Margin="8,0,8,6" FontSize="11" Foreground="#555"
                                   TextWrapping="Wrap" IsHitTestVisible="False"/>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- =================================================================== -->
            <!-- CỘT 3: CHƯƠNG TRÌNH + JSON GẦN NHẤT                                 -->
            <!-- =================================================================== -->
            <GroupBox Header="PROGRAMMING" Grid.Column="2" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F5F5F7" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="3" Padding="6,4" Margin="2,2,2,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Running" FontWeight="Bold" Foreground="Green" VerticalAlignment="Center"
                                       Visibility="{Binding IsProgramRunning, Converter={StaticResource BoolToVisConverter}}"/>
                            <TextBlock Text="{Binding EngineStatus}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" Margin="2"
                             ItemsSource="{Binding ProgramBlocks}"
                             SelectedItem="{Binding SelectedProgramBlock, Mode=TwoWay}"
                             ItemTemplateSelector="{StaticResource BlockSelector}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="White">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <UniformGrid Rows="1" Columns="2" Grid.Row="2" Margin="2,6,2,2">
                        <Button Content="DELETE LINE" Margin="2,0" Height="32" Background="Firebrick" Foreground="White" FontWeight="Bold"
                                Command="{Binding DeleteProgramBlockCommand}" ToolTip="Xoá khối đang chọn"/>
                        <Button Content="CLEAR ALL" Margin="2,0" Height="32" Background="DarkRed" Foreground="White" FontWeight="Bold"
                                Command="{Binding ClearProgramBlocksCommand}" ToolTip="Xoá toàn bộ chương trình"/>
                    </UniformGrid>

                    <!-- Gói JSON gần nhất gửi xuống IPC / nhận từ Camera (để kiểm tra trực quan) -->
                    <Expander Grid.Row="3" Header="JSON gần nhất" Margin="2,6,2,2">
                        <StackPanel>
                            <TextBlock Text="STA → IPC:" FontSize="11" Foreground="Gray"/>
                            <TextBox Text="{Binding LastTxJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     Height="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Camera → GUI:" FontSize="11" Foreground="Gray" Margin="0,4,0,0"/>
                            <TextBox Text="{Binding LastCameraJson, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                     TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
